# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3010
DEMO_MODE=true
SESSION_SECRET=replace-me-with-a-long-random-secret

# Database / infrastructure
DATABASE_URL=postgresql://explainara:explainara@localhost:5432/explainara
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=explainara_chunks
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=explainara
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI routing
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-5.6-mini
AI_FAST_MODEL=gpt-5.6-mini
AI_REASONING_MODEL=gpt-5.6
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LOCAL_OPENAI_BASE_URL=http://localhost:11434/v1
LOCAL_OPENAI_API_KEY=local

# OAuth placeholders. Wire these in your deployment identity provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# OpenMAIC integration. Optional, SDK adapter works when packages are installed.
OPENMAIC_ENABLED=true
OPENMAIC_BASE_URL=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
